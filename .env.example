# ============================================================================
# SaúdeTech Dashboards — configuração de conexão com o PostgreSQL
# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O arquivo .env NÃO deve ser enviado ao Git (já está no .gitignore).
# ============================================================================

# Opção 1 — URL única (é o que o Render mostra em "Connect > External Database URL").
# Se DATABASE_URL estiver preenchida, ela tem prioridade sobre as variáveis abaixo.
# DATABASE_URL=postgresql://admin:SUA_SENHA@dpg-xxxxxxxx-a.ohio-postgres.render.com/saudetech

# Opção 2 — parâmetros separados (no laboratório: preencha DB_USER e DB_PASS
# com o acesso informado pelo professor)
DB_HOST=dpg-dak66hp594qs738hfs90-a.ohio-postgres.render.com
DB_PORT=5432
DB_NAME=saudetech
DB_USER=
DB_PASS=
# O Render exige SSL em conexões externas. Localmente use "prefer" ou "disable".
DB_SSLMODE=require
# Schema onde estão as tabelas do SaúdeTech
DB_SCHEMA=saudetech

# Exibe detalhes de erros de banco na tela (use 1 apenas em desenvolvimento)
APP_DEBUG=0

